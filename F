private void closeQuietly(
        String key,
        AtomikosConnectionFactoryBean factory) {
    if (factory == null) {
        return;
    }
    try {
        factory.close();
    } catch (Exception exception) {
        log.warn(
                "Erreur lors de la fermeture de la factory {}",
                key,
                exception
