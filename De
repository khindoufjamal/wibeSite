Puis ajoutez :

private void closeQuietly(
        AtomikosConnectionFactoryBean factory,
        String key) {
    try {
        factory.close();
    } catch (Exception exception) {
        log.error(
                "Erreur pendant la fermeture de la ConnectionFactory {}",
                key,
                exception
        );
    }
}

